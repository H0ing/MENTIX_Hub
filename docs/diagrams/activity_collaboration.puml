@startuml MENTIX_Hub_Collaboration_Activity
!theme plain

start
:User browses projects;
:User views a project detail;
:User clicks "Request Collaboration";
:Collaboration request form opens;
:User fills in message and submits;
:System validates request;

if (Is user authenticated?) then (yes)
  if (Is recipient valid?) then (yes)
    :System saves collaboration request;
    :System sends notification to recipient;
    :System redirects to success page;
    stop
  else (no)
    :Return error: "Recipient not found";
    stop
  endif
else (no)
  :Redirect to login page;
  stop
endif

@enduml
