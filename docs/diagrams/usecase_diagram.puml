@startuml MENTIX_Hub_UseCase_Diagram
!theme plain
skinparam actorStyle awesome

left to right direction

' --- Actors ---
actor "Student" as Student
actor "Mentor" as Mentor
actor "Moderator" as Moderator
actor "Admin" as Admin
actor "Super Admin" as SuperAdmin

' --- System Boundary ---
rectangle "MENTIX Hub Platform" {
  ' ---- Authentication & Account ----
  usecase "Register Account" as UC1
  usecase "Login" as UC2
  usecase "Verify Email via OTP" as UC3
  usecase "Reset Password" as UC4

  ' ---- Project Management ----
  usecase "Create Project" as UC5
  usecase "Edit Project" as UC6
  usecase "Delete Project" as UC7
  usecase "Upload Project Files" as UC8
  usecase "Browse Projects" as UC9
  usecase "Search Projects" as UC10

  ' ---- Social ----
  usecase "Heart a Project" as UC11
  usecase "Comment on Project" as UC12
  usecase "Favorite a Project" as UC13

  ' ---- Mentorship ----
  usecase "Request Mentorship" as UC14
  usecase "Respond to Mentorship Request" as UC15
  usecase "Request Mentor Promotion" as UC16

  ' ---- Collaboration ----
  usecase "Request Collaboration" as UC17
  usecase "Respond to Collaboration" as UC18

  ' ---- Reporting ----
  usecase "Report Content" as UC19

  ' ---- Moderation ----
  usecase "Review Reports" as UC20
  usecase "Resolve Reports" as UC21
  usecase "Review Mentor Promotions" as UC22

  ' ---- Admin ----
  usecase "Manage Users" as UC23
  usecase "Configure System Settings" as UC24
  usecase "Manage Backups" as UC25
  usecase "Monitor Database Health" as UC26
  usecase "View Audit Logs" as UC27
  usecase "Manage Database Users" as UC28
}

' --- Actor Connections ---
Student --> UC1
Student --> UC2
Student --> UC3
Student --> UC4

Student --> UC5
Student --> UC6
Student --> UC7
Student --> UC8
Student --> UC9
Student --> UC10

Student --> UC11
Student --> UC12
Student --> UC13

Student --> UC14
Student --> UC16
Student --> UC17
Student --> UC19

Mentor --> UC2
Mentor --> UC9
Mentor --> UC10
Mentor --> UC15
Mentor --> UC18

Moderator --> UC2
Moderator --> UC20
Moderator --> UC21
Moderator --> UC22

Admin --> UC2
Admin --> UC23
Admin --> UC24
Admin --> UC25
Admin --> UC26
Admin --> UC27
Admin --> UC28

SuperAdmin --> UC2
SuperAdmin --> UC23
SuperAdmin --> UC24
SuperAdmin --> UC25
SuperAdmin --> UC26
SuperAdmin --> UC27
SuperAdmin --> UC28

' --- Generalization ---
Mentor -->|extends| Student
Moderator -->|extends| Admin
SuperAdmin -->|extends| Admin

@enduml
