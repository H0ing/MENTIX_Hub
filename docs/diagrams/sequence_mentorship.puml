@startuml MENTIX_Hub_Mentorship_Sequence
!theme plain

actor Student as S
actor Mentor as M
participant "Frontend" as FE
participant "API Gateway" as API
participant "Auth Middleware" as Auth
participant "Mentorship Controller" as MC
participant "Mentorship Repository" as MR
participant "Notification Service" as NS
database "MySQL" as DB

== Student Requests Mentorship ==

S -> FE: Clicks "Request Mentorship"
FE -> API: POST /api/mentorships
API -> Auth: Verify JWT token
Auth --> API: Token valid (user_id, role)
API -> MC: createRequest(student_id, mentor_id, project_id, message)
MC -> MR: save(mentorshipData)
MR -> DB: INSERT INTO mentorships
DB --> MR: Return mentorship ID
MR --> MC: Mentorship created
MC -> NS: sendNotification(mentor_id, "New mentorship request")
NS -> DB: INSERT INTO notifications
NS --> MC: Notification sent
MC --> API: 201 Created
API --> FE: { mentorship_id, status: "pending" }
FE --> S: "Request sent successfully"

== Mentor Responds ==

M -> FE: Opens mentorship requests
FE -> API: GET /api/mentorships?role=mentor
API -> Auth: Verify JWT token
Auth --> API: Token valid
API -> MC: listRequests(mentor_id)
MC -> MR: findByMentor(mentor_id)
MR -> DB: SELECT * FROM mentorships WHERE mentor_id = ?
DB --> MR: List of requests
MR --> MC: Return requests
MC --> API: 200 OK
API --> FE: { requests: [...] }
FE --> M: Display requests list

M -> FE: Accepts request with feedback
FE -> API: PUT /api/mentorships/:id
API -> Auth: Verify JWT token
Auth --> API: Token valid
API -> MC: respond(id, "accepted", feedback)
MC -> MR: updateStatus(id, "accepted", feedback)
MR -> DB: UPDATE mentorships SET status = 'accepted', feedback = ?
DB --> MR: Updated
MR --> MC: Success
MC -> NS: sendNotification(student_id, "Mentorship accepted")
NS --> MC: Notification sent
MC --> API: 200 OK
API --> FE: { status: "accepted" }
FE --> M: "Mentorship accepted"

@enduml
